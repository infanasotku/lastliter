{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["egressPools"],
  "properties": {
    "egressPools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "expectedPublicIp", "nodeSelector"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$"
          },
          "enabled": {"type": "boolean"},
          "resourceName": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$"
          },
          "expectedPublicIp": {"type": "string", "minLength": 2},
          "rateLimitPerSecond": {"type": "number", "exclusiveMinimum": 0},
          "replicaCount": {"type": "integer", "minimum": 1},
          "nodeSelector": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    }
  }
}
